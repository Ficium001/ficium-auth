# =============================================================
# ficium-auth — Environment Variables
# Set all of these in Railway → ficium-auth service → Variables
# =============================================================

# ── Deployment ────────────────────────────────────────────────
ENV=production
DEPLOYMENT_MODEL=saas

# ── Server ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=2

# ── Database (Supabase Postgres — auth_portal schema) ─────────
# Supabase → Settings → Database → Connection string (Transaction pooler, port 6543)
DB_URL=postgresql+asyncpg://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ── Redis (Railway Redis service) ─────────────────────────────
REDIS_URL=redis://default:[password]@[host]:[port]/0
REDIS_PASSWORD=

# ── JWT (RS256) ───────────────────────────────────────────────
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ALGORITHM=RS256
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=28800
JWT_ISSUER=ficium-auth
JWT_AUDIENCE=ficium-portal

# ── Session ───────────────────────────────────────────────────
SESSION_COOKIE_NAME=ficium_rt
SESSION_COOKIE_SECURE=true
# Must be "none" — ficium-portal (Vercel) and ficium-auth (Railway) are
# different registrable domains, so this is cross-site. Strict/Lax
# cookies are never sent cross-site and every refresh will 401.
SESSION_COOKIE_SAMESITE=none
SESSION_COOKIE_HTTPONLY=true
# Leave EMPTY unless ficium-auth is genuinely served from a host that
# is a parent domain of the portal (e.g. both under *.ficium.net). A
# mismatched Domain (e.g. portal.ficium.net set from a railway.app
# host) makes the browser silently reject the cookie — refresh tokens
# never get stored and every /auth/refresh 401s with "No refresh token."
SESSION_COOKIE_DOMAIN=
SESSION_MAX_CONCURRENT=3
# Public URL of the ficium-portal frontend — used for verification and
# password-reset email links only (not related to cookies/CORS).
PORTAL_PUBLIC_URL=https://ficium-portal.vercel.app

# ── Email ─────────────────────────────────────────────────────
SMTP_PROVIDER=resend
RESEND_API_KEY=re_...
EMAIL_FROM=portal@ficium.net
EMAIL_FROM_NAME=Ficium Portal

# ── Supabase service role (writes to auth_portal schema) ──────
SUPABASE_URL=https://egwobcajdlragubtkpqp.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# ── CORS ──────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://ficium-portal.vercel.app,https://portal.ficium.net

# Encrypts TOTP secrets at rest. Generate once and keep it: losing it means every
# MFA user must re-enrol. Empty => MFA endpoints answer 503; password login unaffected.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
